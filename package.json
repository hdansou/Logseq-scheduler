{
  "name": "logseq-scheduler",
  "version": "1.0.1",
  "description": "Cron-based scheduler for creating tagged pages in Logseq on a recurring basis",
  "main": "dist/index.html",
  "private": true,
  "homepage": "https://github.com/hdansou/Logseq-scheduler#readme",
  "bugs": {
    "url": "https://github.com/hdansou/Logseq-scheduler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdansou/Logseq-scheduler.git"
  },
  "keywords": [
    "logseq",
    "logseq-plugin",
    "logseq-db",
    "scheduler",
    "cron",
    "recurring-pages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "croner": "^8.1.0"
  },
  "devDependencies": {
    "@logseq/libs": "0.3.2",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.0"
  },
  "logseq": {
    "id": "logseq-scheduler",
    "title": "Scheduler",
    "icon": "./icon.svg",
    "main": "dist/index.html",
    "supportsDB": true,
    "supportsDBOnly": true,
    "minSDKVersion": "0.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "dompurify": ">=3.4.2",
    "lodash-es": ">=4.18.1",
    "postcss": ">=8.5.10"
  },
  "license": "MIT"
}
